{
  "replaceAttrValues": {
    "black": "currentColor",
    "#35433A": "currentColor",
    "white": "{props.fillColor}"
  },
  "svgoConfig": {
    "plugins": [
      {
        "name": "preset-default",
        "params": {
          "overrides": {
            "inlineStyles": {
              "onlyMatchedOnce": false
            },
            "removeViewBox": false,
            "removeUnknownsAndDefaults": false,
            "convertColors": false
          }
        }
      },
      {
        "name": "removeAttrs",
        "params": {
          "attrs": "svg:style"
        }
      }
    ]
  }
}
