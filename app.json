{
  "expo": {
    "name": "RISE",
    "slug": "rise",
    "scheme": [
      "rise",
      "com.anonymous.rise"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.rise",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Allow RISE to access your calendar so it can plan study sessions around your existing events.",
        "NSCalendarsFullAccessUsageDescription": "Allow RISE to access your calendar so it can plan study sessions around your existing events."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2EEE6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-splash-screen",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow RISE to access your calendar so it can plan study sessions around your existing events."
        }
      ],
      "expo-secure-store"
    ]
  }
}
